rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasRole(role) {
      return signedIn()
        && exists(currentUserPath())
        && get(currentUserPath()).data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isStaff() {
      return hasRole("admin")
        || hasRole("moderator")
        || hasRole("accountant")
        || hasRole("editor");
    }

    function hasSpecialty(name) {
      return signedIn()
        && hasRole("specialist")
        && get(currentUserPath()).data.get("specialties", []) is list
        && get(currentUserPath()).data.get("specialties", []).hasAny([name]);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function safeDocumentId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function safeText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function safePhone(value) {
      return value is string && value.matches('^[0-9]{9,15}$');
    }
    function validStoreEdits() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(["name"]) || safeText(request.resource.data.name, 2, 120))
        && (!changed.hasAny(["desc"]) || safeText(request.resource.data.desc, 0, 3000))
        && (!changed.hasAny(["phone"]) || safePhone(request.resource.data.phone))
        && (!changed.hasAny(["area"]) || safeText(request.resource.data.area, 1, 100))
        && (!changed.hasAny(["map"]) || (safeText(request.resource.data.map, 0, 1200)
          && (request.resource.data.map == "" || request.resource.data.map.matches('^https://.+$'))))
        && (!changed.hasAny(["logo"]) || safeImageData(request.resource.data.logo))
        && (!changed.hasAny(["cover"]) || safeImageData(request.resource.data.cover))
        && request.resource.data.get("logo", "").size()
          + request.resource.data.get("cover", "").size() <= 850000;
    }
    function validReviewData(id) {
      return signedIn()
        && safeDocumentId(id)
        && request.resource.data.keys().hasOnly([
          "storeId", "userId", "userName", "stars", "text", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "storeId", "userId", "userName", "stars", "text", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storeId is string
        && safeDocumentId(request.resource.data.storeId)
        && id == request.resource.data.storeId + "_" + request.auth.uid
        && safeText(request.resource.data.userName, 1, 100)
        && safeText(request.resource.data.text, 0, 1500)
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.status == "approved";
    }
    function safeImageData(value) {
      return value is string
        && value.size() <= 700000
        && (value == "" || value.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    function ownsApprovedStore(storeId) {
      return signedIn()
        && storeId is string
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/stores/$(storeId)).data.status == "approved";
    }

    function ownsApprovedAd(adId) {
      return signedIn()
        && adId is string
        && exists(/databases/$(database)/documents/ads/$(adId))
        && get(/databases/$(database)/documents/ads/$(adId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/ads/$(adId)).data.status == "approved";
    }

    match /users/{uid} {
      allow get, list: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.role == "user"
        && request.resource.data.stars == 0
        && request.resource.data.keys().hasOnly(["name", "email", "role", "stars", "acceptedTermsVersion", "acceptedPrivacyVersion", "acceptedAt"])
        && request.resource.data.keys().hasAll(["name", "email", "role", "stars", "acceptedTermsVersion", "acceptedPrivacyVersion", "acceptedAt"])
        && safeText(request.resource.data.name, 1, 100)
        && safeText(request.resource.data.email, 6, 254)
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.acceptedTermsVersion == "2026-11-19"
        && request.resource.data.acceptedPrivacyVersion == "2026-11-19"
        && request.resource.data.acceptedAt == request.time;
      allow update: if (isAdmin() && changedOnly(["name", "role", "specialties"])
          && safeText(request.resource.data.name, 1, 100)
          && request.resource.data.role in ["user", "specialist", "moderator", "accountant", "editor", "admin"]
          && request.resource.data.get("specialties", []) is list
          && request.resource.data.get("specialties", []).hasOnly(["jobs", "pharmacy", "doctor", "fuel"])
          && request.resource.data.get("specialties", []).size() <= 4)
        || (isSelf(uid) && changedOnly(["name"])
          && safeText(request.resource.data.name, 1, 100));
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{id} {
      allow read: if resource.data.status == "approved"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isStaff()
        || (hasSpecialty("jobs") && resource.data.cat == "jobs");

      // Trusted souqnaMarketplace callable enforces quotas and submission validation.
      allow create: if false;
      allow update: if (isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["featuredUntil", "status", "ownerId", "createdAt"]));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /stores/{id} {
      allow read: if resource.data.status == "approved"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isStaff();
      // Trusted souqnaMarketplace callable enforces quotas and submission validation.
      allow create: if false;
      allow update: if (isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["plan", "planUntil", "status", "ownerId", "createdAt"]))
        || (signedIn() && resource.data.ownerId == request.auth.uid
          && changedOnly(["name", "desc", "phone", "area", "map", "logo", "cover"])
          && validStoreEdits());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.storeId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["storeId", "userId"]);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /favorites/{id} {
      // Private favorites, one record per authenticated user and approved listing.
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.adId is string
        && safeDocumentId(request.resource.data.adId)
        && id == request.auth.uid + "_" + request.resource.data.adId
        && request.resource.data.createdAt is int
        && request.resource.data.keys().hasOnly(["userId", "adId", "createdAt"])
        && exists(/databases/$(database)/documents/ads/$(request.resource.data.adId))
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.status == "approved";
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if validReviewData(id);
      allow update: if validReviewData(id)
        && resource.data.userId == request.auth.uid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly(["userName", "stars", "text"]);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{id} {
      allow read: if true;
      // Manual admin banners are permitted; paid booking banners require backend approval.
      allow create: if isAdmin() && !("requestId" in request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /sponsorRequests/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.days >= 1
        && request.resource.data.days <= 90
        && request.resource.data.days is int
        && safeText(request.resource.data.userName, 1, 100)
        && safeText(request.resource.data.company, 2, 100)
        && safeText(request.resource.data.title, 3, 120)
        && safeText(request.resource.data.desc, 0, 500)
        && safePhone(request.resource.data.phone)
        && safeImageData(request.resource.data.img)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.keys().hasOnly([
          "userId", "userName", "company", "title", "desc",
          "phone", "days", "img", "status", "createdAt"
        ]);
      // Payments and approvals are performed by the Admin SDK only.
      allow update, delete: if false;
    }

    match /directory/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (hasSpecialty(request.resource.data.type)
          && request.resource.data.type in ["pharmacy", "doctor", "fuel"]
          && request.resource.data.keys().hasOnly([
            "type", "name", "spec", "area", "phone", "stars", "onDuty", "active", "createdAt"
          ])
          && safeText(request.resource.data.name, 2, 120)
          && safeText(request.resource.data.spec, 0, 500)
          && safeText(request.resource.data.area, 0, 100)
          && safeText(request.resource.data.phone, 0, 32)
          && request.resource.data.stars is int
          && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
          && request.resource.data.onDuty is bool
          && request.resource.data.active is bool
          && request.resource.data.createdAt is int);
      allow update: if isAdmin()
        || (hasSpecialty(resource.data.type)
          && request.resource.data.type == resource.data.type
          && changedOnly(["name", "spec", "area", "phone", "stars", "onDuty", "active"])
          && safeText(request.resource.data.name, 2, 120)
          && request.resource.data.onDuty is bool
          && request.resource.data.active is bool);
      allow delete: if isAdmin() || hasSpecialty(resource.data.type);
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /starOrders/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.stars is int
        && request.resource.data.stars > 0
        && request.resource.data.stars <= 100000
        && safeText(request.resource.data.userName, 1, 100)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.keys().hasOnly([
          "userId", "userName", "stars", "status", "createdAt"
        ]);
      allow update, delete: if false;
    }

    match /promos/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && ownsApprovedAd(request.resource.data.adId);
      allow update, delete: if false;
    }

    match /subs/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && ownsApprovedStore(request.resource.data.storeId)
        && request.resource.data.planId is string
        && exists(/databases/$(database)/documents/plans/$(request.resource.data.planId));
      allow update, delete: if false;
    }

    match /sorders/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if safeDocumentId(id) && signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "new"
        && safeText(request.resource.data.userName, 1, 100)
        && request.resource.data.serviceId is string
        && safeDocumentId(request.resource.data.serviceId)
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && request.resource.data.serviceName ==
          get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.name
        && safeText(request.resource.data.serviceName, 1, 120)
        && safeText(request.resource.data.partnerName, 0, 120)
        && safeText(request.resource.data.details, 2, 3000)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.keys().hasOnly([
          "userId", "userName", "serviceId", "serviceName", "partnerName", "details",
          "status", "createdAt"
        ]);
      allow update: if isStaff()
        && changedOnly(["status", "note"])
        && request.resource.data.status in ["new", "progress", "done", "rejected"]
        && safeText(request.resource.data.get("note", ""), 0, 500);
      allow delete: if isAdmin();
    }

    match /moderationAudit/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentReceipts/{id} {
      // Manual payment proofs are finance-only: clients must never forge or edit them.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /transactions/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Financial ledger is write-once from trusted server credentials.
      allow create, update, delete: if false;
    }

    match /notifs/{id} {
      // Financial and personal notifications remain private to owner and administrator.
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isStaff()
        && safeDocumentId(id)
        && request.resource.data.keys().hasOnly(["userId", "text", "read", "createdAt"])
        && request.resource.data.userId is string
        && safeDocumentId(request.resource.data.userId)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
        && safeText(request.resource.data.text, 1, 500)
        && request.resource.data.read == false
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0;
      allow update: if (isAdmin() && changedOnly(["read", "text"])
          && request.resource.data.read is bool
          && safeText(request.resource.data.text, 1, 500))
        || (signedIn() && resource.data.userId == request.auth.uid
          && changedOnly(["read"]) && request.resource.data.read == true);
      allow delete: if isAdmin();
    }

    function auctionOffice() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/auctionTestStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/auctionTestStaff/$(request.auth.uid)).data.enabled == true);
    }
    match /auctionTestPublic/{id} {
      allow read: if true;
      match /history/{bid} { allow read: if true; }
    }
    match /auctionTestSettings/{id} { allow read: if true; }
    match /auctionTestReports/{id} { allow read: if auctionOffice(); }
    match /auctionTestLots/{id} {
      allow read: if auctionOffice() && resource.data.status == "draft";
      match /media/{file} {
        allow get: if auctionOffice() || (exists(/databases/$(database)/documents/auctionTestPublic/$(id))
          && (file in get(/databases/$(database)/documents/auctionTestPublic/$(id)).data.photos
            || file == get(/databases/$(database)/documents/auctionTestPublic/$(id)).data.pdf));
      }
    }
    match /auctionTestWallets/{uid} { allow get: if isSelf(uid) || auctionOffice(); }
    match /auctionTestAudit/{id} { allow read: if isAdmin(); }
    match /auctionTestIssues/{id} { allow read: if auctionOffice() || isSelf(resource.data.uid); }

    // Survey data goes through authenticated server callables only.
    match /rewardsSurveys/{id} {
      allow read, write: if false;
    }
    match /rewardsSurveyParticipants/{id} {
      allow read, write: if false;
    }
    match /rewardsSurveyResponses/{id} {
      allow read, write: if false;
    }
  }
}
