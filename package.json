{
  "name": "souqna-security-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Development-only checks for Souqna; does not deploy Firebase",
  "scripts": {
    "test:source": "node scripts/check-souqna.mjs",
    "test:rules": "firebase emulators:exec --project demo-souqna-rules --only auth,firestore,functions \"node --test tests/*.test.mjs\"",
    "test": "npm run test:source && npm run test:rules",
    "build:hosting": "node scripts/build-hosting.mjs",
    "test:release": "npm run test:source && npm run test:build-isolation && npm run build:hosting",
    "test:build-isolation": "node --test tests/staging-build.test.mjs",
    "build:staging": "node scripts/build-hosting.mjs staging",
    "preflight:staging": "node scripts/preflight-staging.mjs",
    "seed:staging": "node scripts/seed-staging.mjs",
    "setup:staging:auto": "node scripts/auto-staging-setup.mjs",
    "test:admin": "node --test tests/admin-access-source.test.mjs tests/staging-admin-diagnostic.test.mjs tests/moderation-source.test.mjs",
    "diagnose:staging:admin": "node scripts/diagnose-staging-admin.mjs",
    "test:moderation": "node --test tests/moderation-source.test.mjs",
    "verify:staging": "node scripts/build-hosting.mjs staging firebase.staging.json && node scripts/preflight-staging.mjs souqna-staging",
    "check:staging:services": "node scripts/check-staging-services.mjs",
    "start:staging:windows": "powershell.exe -NoProfile -File scripts/start-staging.ps1",
    "check:staging:hosting": "node scripts/check-staging-hosting.mjs",
    "check:staging:readiness": "node scripts/staging-readiness.mjs",
    "upgrade:staging:categories": "node scripts/upgrade-staging-categories.mjs --project souqna-staging",
    "check:staging:categories": "node scripts/check-staging-categories.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0",
    "playwright": "1.56.1"
  }
}
