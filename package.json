{
  "name": "souqna-security-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Development-only checks for Souqna; does not deploy Firebase",
  "scripts": {
    "test:source": "node scripts/check-souqna.mjs",
    "test:rules": "firebase emulators:exec --project demo-souqna-rules --only auth,firestore \"node --test tests/*.test.mjs\"",
    "test": "npm run test:source && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0",
    "playwright": "1.56.1"
  }
}
