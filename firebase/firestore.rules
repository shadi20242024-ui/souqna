rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function auth() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function myProfile() { return auth() && exists(userPath(request.auth.uid)); }
    function role() { return get(userPath(request.auth.uid)).data.role; }
    function staff() { return admin() || (myProfile() && role() in ['admin', 'moderator', 'accountant', 'editor']); }
    function admin() { return auth() && request.auth.token.admin == true; }
    function owner(field) { return auth() && resource.data[field] == request.auth.uid; }
    function onlyChanged(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function validStars(n) { return n is int && n > 0 && n <= 100000; }

    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /packages/{id} { allow read: if true; allow write: if admin(); }
    match /plans/{id} { allow read: if true; allow write: if admin(); }
    match /services/{id} { allow read: if true; allow write: if admin(); }
    match /partners/{id} { allow read: if true; allow write: if admin(); }
    match /sponsors/{id} { allow read: if true; allow write: if admin(); }
    match /directory/{id} { allow read: if true; allow write: if staff(); }

    match /users/{uid} {
      allow read: if auth() && (request.auth.uid == uid || staff());
      allow create: if auth() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','role','stars','createdAt'])
        && request.resource.data.role == 'user' && request.resource.data.stars == 0
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      // Financial balance and privilege changes are server-only.
      allow update: if auth() && request.auth.uid == uid
        && onlyChanged(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
    }

    match /stores/{id} {
      allow read: if resource.data.status == 'approved' || owner('ownerId') || staff();
      allow create: if auth() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('plan' in request.resource.data) && !('planUntil' in request.resource.data);
      allow update: if (staff() && onlyChanged(['name','desc','phone','area','map','logo','cover'])) || (owner('ownerId')
        && onlyChanged(['name','desc','phone','area','map','logo','cover']));
      allow delete: if admin() || owner('ownerId');
    }
    match /ads/{id} {
      allow read: if resource.data.status == 'approved' || owner('ownerId') || staff();
      allow create: if auth() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('featuredUntil' in request.resource.data)
        && (!('storeId' in request.resource.data)
          || (exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
              && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid));
      allow update: if (staff() && onlyChanged(['title','price','cur','cat','area','desc','phone','img'])) || (owner('ownerId')
        && onlyChanged(['title','price','cur','cat','area','desc','phone','img']));
      allow delete: if admin() || owner('ownerId');
    }

    match /starOrders/{id} {
      allow create: if auth() && request.resource.data.keys().hasOnly(['userId','userName','stars','status','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validStars(request.resource.data.stars);
      allow read: if owner('userId') || staff();
      // Server-side Admin SDK only.
    }
    match /promos/{id} {
      allow create: if auth() && request.resource.data.keys().hasOnly(['userId','userName','adId','adTitle','pkgId','stars','days','status','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.days is int && request.resource.data.days > 0;
      allow read: if owner('userId') || staff();
    }
    match /subs/{id} {
      allow create: if auth() && request.resource.data.keys().hasOnly(['userId','userName','storeId','storeName','planId','planName','stars','days','status','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.days is int && request.resource.data.days >= 0;
      allow read: if owner('userId') || staff();
    }
    match /transactions/{id} { allow read: if owner('userId') || staff(); }
    match /notifs/{id} {
      allow read: if owner('userId');
      allow update: if owner('userId') && onlyChanged(['read'])
        && request.resource.data.read is bool;
    }
    match /sorders/{id} {
      allow create: if auth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new';
      allow read: if owner('userId') || staff();
      allow update: if staff();
      allow delete: if admin();
    }
    match /follows/{id} {
      allow read: if true;
      allow create: if auth() && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.storeId + '_' + request.auth.uid;
      allow delete: if owner('userId');
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if auth() && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.storeId + '_' + request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow update: if owner('userId')
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.storeId == resource.data.storeId
        && onlyChanged(['stars','text','createdAt'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if admin() || owner('userId');
    }
  }
}
